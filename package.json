{
	"name": "language-learning-app",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "pnpm --filter backend dev",
		"start": "pnpm --filter backend start",
		"build": "rm -rf dist && bun build ./frontend/index.html --outdir dist --minify --public-path / --env 'BUN_PUBLIC_*' && cp -r frontend/public/. dist/",
		"lint": "biome check --write .",
		"typecheck": "pnpm -r --parallel --no-bail typecheck"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11"
	}
}
