{
	"compilerOptions": {
		"target": "esnext",
		"module": "preserve",
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"strict": true,
		"types": ["bun"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"exclude": ["**/*.test.ts"]
}
